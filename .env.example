# ──────────────────────────────────────────────────────────────────────
# AgentTrading CLI Configuration
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Paper mode works with zero API keys — just run `bun run start`.

# ── Mode ──────────────────────────────────────────────────────────────
# Active system mode. Options: "paper" (default) | "live"
# Paper mode is the initial operating phase:
# - uses Bybit demo trading / simulation paths first
# - validates REST and WebSocket connectivity
# - exercises order lifecycle, reconciliation, and risk limits
# - does not risk real capital
# Live mode is a separate, explicit transition:
# - connects to Bybit private+public WebSocket
# - places real orders
# - requires API keys and additional safety checks
MODE=paper

# ── Bybit API Keys (live mode only) ──────────────────────────────────
# Generate API keys at https://www.bybit.com/app/user/api-management
# IMPORTANT: Disable withdrawals on the trading key!
# These are ignored in paper mode and should only be enabled after the
# paper phase has been validated end-to-end.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Cycle Configuration ──────────────────────────────────────────────
# How often (ms) the system evaluates opportunities and runs a trading cycle.
# Default: 5000 (5 seconds)
CYCLE_INTERVAL_MS=5000

# ── Config Override ──────────────────────────────────────────────────
# Path to a JSON config file that overrides default canary limits.
# Example: --config canary.json
# The JSON file overrides DEFAULT_CANARY_CONFIG fields:
#   capitalLimits, exposureLimits, orderLimits, scope, killSwitch, etc.
CONFIG_PATH=

# ── Logging ──────────────────────────────────────────────────────────
# Log level. Options: "debug" | "info" (default) | "warn" | "error"
LOG_LEVEL=info

# ── Reports ──────────────────────────────────────────────────────────
# Directory for session reports (TXT, JSON, CSV) and audit logs (JSONL).
# Default: ./reports
REPORT_DIR=./reports
