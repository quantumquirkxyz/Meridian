# ──────────────────────────────────────────────────────────────────────
# AgentTrading CLI Configuration
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Active system mode. Options: "demo" | "live"
# Demo validates Bybit REST/WebSocket integration with virtual assets.
# Live uses real Bybit endpoints with bounded capital.
# - exercises order lifecycle, reconciliation, and risk limits
# - does not risk real capital in demo
# Demo mode is the exchange-integration proving mode (Bybit Demo Trading):
# - uses Bybit Demo Trading, not live mainnet
# - requires demo API keys at runtime/config time
# - validates demo REST and private WebSocket connectivity with virtual assets
# - reads public market data from the normal Bybit public stream
# - must not share the live runner or live credentials
# Live mode is a separate, explicit transition (after demo evidence):
# - connects to Bybit private+public WebSocket
# - places real orders
# - requires API keys with withdrawals disabled and additional safety checks
MODE=demo

# ── Market Feed ──────────────────────────────────────────────────────
# Use the public Bybit market stream (default). No synthetic feed.
MARKET_FEED_MODE=public

# ── LLM / Agent Runtime (Vercel AI SDK / OpenRouter) ────────────
# OpenRouter base URL for LLM agent reasoning. Default: OpenAI-compatible endpoint.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# ── Bybit API Keys (demo/live modes only) ────────────────────────────
# Generate API keys at https://www.bybit.com/app/user/api-management
# IMPORTANT: Disable withdrawals on the trading key!
# These are required for demo (Bybit Demo Trading keys) and live
# (real keys with withdrawals disabled). They are not simulated.
# Use demo keys for MODE=demo and real trading keys only for MODE=live
# after demo has passed and promotion evidence exists.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── PancakeSwap / BNB Chain (DEX) ─────────────────────────────────────
# Optional DEX venue for on-chain market data and swap execution.
# RPC endpoint for the BNB Chain (required for DEX market data).
PANCAKESWAP_RPC_URL=
# Comma-separated pool specs: poolAddress:token0:token1
# e.g. 0x58F876857a02D6762E0101bb5C46A8c1ED44Dc16:WBNB:USDT
PANCAKESWAP_POOLS=
# Private key (hex, 0x-prefixed) that signs on-chain swaps. EMPTY = market data only.
PANCAKESWAP_PRIVATE_KEY=
# PancakeSwap router address for swap execution.
PANCAKESWAP_ROUTER_ADDRESS=

# ── Cycle Configuration ──────────────────────────────────────────────
# How often (ms) the system evaluates opportunities and runs a trading cycle.
# Default: 5000 (5 seconds)
CYCLE_INTERVAL_MS=5000

# ── Config Override ──────────────────────────────────────────────────
# Path to a JSON config file that overrides default canary limits.
# Example: --config canary.json
# The JSON file overrides DEFAULT_CANARY_CONFIG fields:
#   capitalLimits, exposureLimits, orderLimits, scope, killSwitch, etc.
CONFIG_PATH=

# ── Logging ──────────────────────────────────────────────────────────
# Log level. Options: "debug" | "info" (default) | "warn" | "error"
LOG_LEVEL=info

# ── Reports ──────────────────────────────────────────────────────────
# Directory for session reports (TXT, JSON, CSV) and audit logs (JSONL).
# Default: ./reports
REPORT_DIR=./reports
