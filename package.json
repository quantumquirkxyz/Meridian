{
  "name": "agenttrading",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun run packages/cli/src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "bun run typecheck",
    "verify:all": "bun run typecheck && bun test",
    "audit": "bun audit",
    "audit:fix": "bun audit && bun update"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  }
}
