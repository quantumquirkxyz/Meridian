{
  "name": "@agenttrading/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic core: StateGraph, Risk, Execution, Reconciliation. Never imports LLMs or connectors (ARCHITECTURE.md boundary).",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./stategraph": "./src/stategraph/state-graph.ts",
    "./risk": "./src/risk/risk-gate.ts",
    "./execution": "./src/execution/simulated-execution-engine.ts",
    "./reconciliation": "./src/reconciliation/reconciliation-engine.ts",
    "./session": "./src/live/trading-session.ts",
    "./inventory": "./src/inventory/inventory-engine.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agenttrading/contracts": "workspace:*",
    "@agenttrading/core-execution": "workspace:*",
    "@agenttrading/core-inventory": "workspace:*",
    "@agenttrading/core-reconciliation": "workspace:*",
    "@agenttrading/core-risk": "workspace:*",
    "@agenttrading/core-session": "workspace:*",
    "@agenttrading/core-stategraph": "workspace:*",
    "@agenttrading/graph": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
