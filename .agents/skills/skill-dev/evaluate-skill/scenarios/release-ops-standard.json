    "release-management",
    "deployment",
    "observability",
    "monitoring-alerting"
  ],
  "checks": [
    {
      "skill": "release-management",
      "mustMention": ["release decision record", "required", "approval", "rollback"]
    },
    {
      "skill": "deployment",
      "mustMention": ["artifact", "rollout", "rollback", "deployment safety gates"]
    },
    {
      "skill": "monitoring-alerting",
      "mustMention": ["owner", "severity", "runbook", "response ownership"]
    }
  ]
}
